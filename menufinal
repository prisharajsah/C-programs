#include <stdio.h>
#include <malloc.h>

struct node{
	int data;
	struct node *ptr;
};

typedef struct node node;
node *head=NULL;

void insertBeginning(){
	int item;
	node *new_node = (node*)malloc(sizeof(node));
 
	printf("Enter data to insert at beginning: ");
	scanf("%d",&item);
	new_node->data=item;
	new_node->ptr=head;
	head=new_node;	
}

void insertEnd(){
	int item;
	node *new_node = (node*)malloc(sizeof(node));
	
	node*temp=head;
	
	printf("Enter data to insert at end: ");
	scanf("%d",&item);
	
	new_node->data=item;
	new_node->ptr=NULL;
	
	if(head==NULL){
		head=new_node;
	}
	else{
		while(temp->ptr != NULL){
		    temp=temp->ptr;	
	    }
	    temp->ptr = new_node;
	}
}


void insertAnywhere(){
	int item,pos;
	node *new_node = (node*)malloc(sizeof(node));
	
	printf("Enter data to insert: ");
	scanf("%d",&item);
	printf("Enter position to insert item: ");
	scanf("%d",&pos);
	
	new_node->data = item;
	
	if(pos==1){
		new_node->ptr=head;
	    head=new_node;
	}
	else{
		node*temp=head;
		
		for(int k=1;k<pos-1;k++){
			temp=temp->ptr;
			if(temp==NULL){
				printf("Nodes in the list are less than count");
				return;
			}
		}		
		new_node->ptr = temp->ptr;
		temp->ptr = new_node;
	}				
}

void countNode(){
	int count=0;
	node*temp=head;
	
	while(temp!=NULL){
		count++;
		temp=temp->ptr;
	}
	printf("Node Count: %d",count);
}

void display(){
	node *temp=head;
	
	if(head==NULL){
		printf("Linked list is empty");
		return;
	}
	else{
		printf("Linked List: ");
		while(temp!=NULL){
			printf("%d ",temp->data);
			temp=temp->ptr;
		}
	}
}

void deleteFirst(){
	struct node *temp;
	
	if(head==NULL){
		printf("Linked List is empty");
		return;
	}
	else{
		temp=head;
	    head=head->ptr;
	    free(temp);
	}
}

void deleteLast(){
	struct node *temp1, *temp2;
	if(head==NULL){
		printf("Linked List is empty");
		return;
	}
	else if(head->ptr == NULL){
		free(head);
		head=NULL;
	}
	else{
		temp1=head;
	    while(temp1->ptr != NULL){
	    	temp2=temp1->ptr;
	    	if(temp2->ptr==NULL){
	    		break;
			}
			temp1=temp2;
		}
		free(temp2);
		temp1->ptr=NULL;
	}
}

void deleteAny(){
	int item;
	struct node *temp1, *temp2;
	
	printf("Enter element to be deleted: ");
	scanf("%d",&item);
	
	temp2=head;
	temp1=NULL;
	
	while(temp2!=NULL){
		if(temp2->data == item){
			if(temp1 == NULL){
				head = temp2->ptr;
			}
			else{
				temp1->ptr = temp2->ptr;
			}
			free(temp2);
			printf("Node deleted");
			return;
		}
		temp1=temp2;
		temp2=temp2->ptr;
	}
	printf("Element not found");
}

void reversePrint(){
	struct node *p,*q;
	p=NULL;
	
	while(p!=head){
		q=head;
		while(q->ptr != p){
			q = q->ptr;
		}
		printf("%d",q->data);
		p=q;
	}
}

int main(){  
    int choice;
	printf("Welcome!");
	printf("\n1.Insert node at beginning");
	printf("\n2.Insert node at end");
	printf("\n3.Insert node anywhere");
	printf("\n4.Count the number of node");
	printf("\n5.Display");
	printf("\n6.Delete first node");
	printf("\n7.Delete last node");
	printf("\n8.Delete any node");
	printf("\n9.Reverse print linked list");
	printf("\n10.Exit");
    
    do{
		printf("\n\nKindly enter your choice: ");
	    scanf("%d",&choice);
	
		switch(choice){
		case 1:
			insertBeginning();
			break;
		case 2:
			insertEnd();
			break;
		case 3:
			insertAnywhere();
			break;
		case 4:
			countNode();
			break;
		case 5:
			display();
			break;
		case 6:
			deleteFirst();
			break;
		case 7:
			deleteLast();
			break;
		case 8:
			deleteAny();
			break;
		case 9:
			reversePrint();
			break;
		case 10:
			printf("Terminating, Thankyou!");
			break;
		default:
			printf("Invalid choice");
			break;
	    }
	}while(choice!=6);
    
    return 0;
}
