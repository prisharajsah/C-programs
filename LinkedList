#include <stdio.h>
#include <malloc.h>

struct node{
	int data;
	struct node *ptr;
};

typedef struct node node;
node *head=NULL;

void insertBeginning(){
	int item;
	node *new_node = (node*)malloc(sizeof(node));
 
	printf("Enter data to insert at beginning: ");
	scanf("%d",&item);
	new_node->data=item;
	new_node->ptr=head;
	head=new_node;	
}

void display(){
	node *temp=head;
	
	if(head==NULL){
		printf("Linked list is empty");
		return;
	}
	else{
		printf("Linked List: ");
		while(temp!=NULL){
			printf("%d ",temp->data);
			temp=temp->ptr;
		}
	}
}

int main(){  
    int choice;
	printf("Welcome!");
	printf("\n1.Insert node in beginning");
	printf("\n2.Display");
	printf("\n3.Exit");
    
    do{
		printf("\n\nKindly enter your choice: ");
	    scanf("%d",&choice);
	
		switch(choice){
		case 1:
			insertBeginning();
			break;
		case 2:
			display();
			break;
		case 3:
			printf("Terminating, Thankyou!");
			break;
		default:
			printf("Invalid choice");
			break;
	    }
	}while(choice!=3);
    
    return 0;
}
