#include <stdio.h>

int main(){
    int i, size, maxPos=0, minPos=0, temp;
    printf("Enter size of the array: ");
    scanf("%d", &size);

    int arr[size];

    //inputting elements of array
    printf("Enter elements of the array: ");
    for(i=0; i<size; i++){
        scanf("%d", &arr[i]);
    }

    //printing elements of array
    printf("The elements are: ");
    for(i=0; i<size; i++){
        printf("%d ", arr[i]);
    }

    //finding max and min and their positions
    int max=arr[0], min=arr[0];
    for(i=0; i<size; i++){
        if(arr[i]>max){
            max=arr[i];
            maxPos=i;
        }

        if(arr[i]<min){
            min=arr[i];
            minPos=i;
        }
    }

    printf("\nThe maximum value is: %d ", max);
    printf("\nThe minimum value is: %d ", min);

    //swapping max and min positions
    temp=arr[maxPos];
    arr[maxPos]=arr[minPos];
    arr[minPos]=temp;

    //printing swapped array
    printf("\nThe elements after swapping max and min: ");
    for(i=0; i<size; i++){
        printf("%d ", arr[i]);
    }

    return 0;
}
