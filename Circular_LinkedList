#include <stdio.h>
#include <malloc.h>

struct node{
	int data;
	struct node *ptr;
};

typedef struct node node;
node *first,*last;

node *allocate(){
	return (node*)malloc(sizeof(node));
}

void insert_beg(){
	node *new_node=allocate();
	int item;
	printf("Enter item to insert at beginning: ");
	scanf("%d",&item);
	
	new_node->data = item;
	if (first==NULL){
		first = new_node;
		last=new_node;
		new_node->ptr = first;
	}
	else{
		new_node->ptr = first;
	    first = new_node;
	    last->ptr = first;
	}
}

void insert_end(){
	node *new_node=allocate();
	int item;
	printf("Enter item to insert at end: ");
	scanf("%d",&item);
	
	new_node->data = item;
	if (first==NULL){
		first = new_node;
		last=new_node;
		new_node->ptr = first;
	}
	else{
		new_node->ptr = first;
	    last->ptr = new_node;
	    last = new_node;
	}
}


void display(){
	node *temp;
	temp = first;
	
	if(first==NULL){
		printf("List is empty");
	}
	else{
		printf("Circular linked list: ");
		do{
			printf("%d ",temp->data);
			temp = temp->ptr;
		}
		while(temp != first);
	}
}

void delete_beg(){
	node *temp;
	if (first==NULL){
		printf("List is empty");
	}
	else if(first==last){
		temp=first;
		first=NULL;
		last=NULL;
		free(temp);
	}
	else{
		temp=first;
		first=first->ptr;
		last->ptr=first;
		free(temp);
	}
}

void delete_end(){
	node *temp;
	if (first==NULL){
		printf("List is empty");
	}
	else if(first==last){
		temp=first;
		first=NULL;
		last=NULL;
		free(temp);
	}
	else{
		temp=first;
		
		while(temp->ptr != last){
			temp=temp->ptr;
		}
		temp->ptr=first;
		free(last);
		last=temp;
	}
}

int main(){ 
    int choice;
	printf("Welcome!");
	printf("\n1.Insert at beginning");
	printf("\n2.Insert at end");
	printf("\n3.Display");
	printf("\n4.Delete from the beginning");
	printf("\n5.Delete from the end");
	printf("\n6.Exit");
	
	do{
		printf("\nKindly enter your choice: ");
	    scanf("%d",&choice);
	
		switch(choice){
		case 1:
			insert_beg();
			break;
		case 2:
			insert_end();
			break;
		case 3:
			display();
			break;
		case 4:
			delete_beg();
			break;
		case 5:
			delete_end();
			break;
		case 6:
			printf("Terminating, Thankyou!");
			break;
		default:
			printf("Invalid choice");
			break;
	    }
	}while(choice!=6);
	return 0;
}
