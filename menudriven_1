#include <stdio.h>

int main(){
	int choice;
	printf("Welcome to Prisha's Coffee Shop");
	printf("\n~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~");
	printf("\nMenu:");
	printf("\n1.Coffee");
	printf("\n2.Tea");
	printf("\n3.Cold drink");
	
	printf("\nKindly enter your choice:");
	scanf("%d",&choice);
	
	switch(choice){
		case 1:
			printf("Here's your Coffee! Good day :)");
			break;
		case 2:
			printf("Here's your Tea! Good day :)");
			break;
		case 3:
			printf("Here's your Cold drink! Good day :)");
			break;
		default:
			printf("Invalid choice!");
	}
	return 0;
}	

