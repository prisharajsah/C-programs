#include <stdio.h>

void move_disks(int n,char source, char dest, char temp){
	if(n>0){
		move_disks(n-1,source,temp,dest);
		printf("Move disk %d from %c to %c\n", n,source,dest);
		
		move_disks(n-1,temp,dest,source);
	}
}

int main(){
	int diskCount;
	
	printf("Enter number of disks: ");
	scanf("%d",&diskCount);
	
	if(diskCount<=3){
		move_disks(diskCount,'S','D','T');
	}
	else{
		printf("Maximum number of disks is 3");
	}
	return 0;
}
